# ─────────────────────────────────────────────────────────
# LoadLight — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...your-anon-key

# ── AI Providers ──────────────────────────────────────────
# Optional Google AI API key. Apply the AI quota block in supabase/MIGRATIONS.sql first.
# Guests and users without an available AI quota use local suggestions.
# Get a key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional public Google OAuth web client ID for importing calendar busy times.
NEXT_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
